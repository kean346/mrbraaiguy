# Set unique secrets in your deployment secret manager. Never commit real values.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=ember-rs&directConnection=true
MONGODB_DB=ember_glass
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-value-at-least-32-characters
OWNER_EMAIL=owner@example.invalid
# Local development only; Vercel uses the packaged serverless Chromium binary.
CHROMIUM_PATH=/usr/bin/chromium
# Set temporarily only while running npm run owner:create, then remove.
# OWNER_BOOTSTRAP_PASSWORD=
# Production owner setup only: generate a unique random code of 32+ characters in your password manager.
# OWNER_SETUP_CODE=
