{
  "name": "ember-glass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "db:start": "bash scripts/mongo.sh",
    "owner:create": "tsx --env-file=.env.local scripts/owner.ts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "mongodb": "7.7.0",
    "better-auth": "1.7.14",
    "zod": "^4.3.6",
    "decimal.js": "^10.6.0",
    "sanitize-html": "^2.17.0",
    "puppeteer-core": "^24.37.5",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "lucide-react": "^0.577.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "csv-parse": "^6.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18",
    "@playwright/test": "^1.58.2",
    "@axe-core/playwright": "^4.11.1"
  }
}
